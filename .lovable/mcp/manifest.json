        "description": "List the signed-in user's generation sessions (newest first) with their title, active model and preset.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "How many sessions to return (1-50)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_session",
        "title": "Get session detail",
        "description": "Read one of the signed-in user's sessions: its prompts (messages) and the assets generated in it.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "description": "The session id (uuid)."
            },
            "include_urls": {
              "type": "boolean",
              "description": "Include a temporary signed download URL for each asset."
            }
          },
          "required": [
            "session_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_assets",
        "title": "List generated assets",
        "description": "List the signed-in user's generated images and videos, newest first, optionally filtered by session or media type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "description": "Only assets from this session id."
            },
            "asset_type": {
              "type": "string",
              "enum": [
                "image",
                "video"
              ],
              "description": "Filter by media type."
            },
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "How many assets to return (1-50)."
            },
            "include_urls": {
              "type": "boolean",
              "description": "Include temporary signed download URLs."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_models",
        "title": "List generation models",
